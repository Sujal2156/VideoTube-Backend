{
  "info": {
    "_postman_id": "videotube-api-collection",
    "name": "VideoTube API Collection",
    "description": "Postman API Collection for VideoTube backend — covering Auth, Video management, Comments, Likes, Playlists, Subscriptions, Tweets, and Dashboard analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{ACCESS_TOKEN}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 - Healthcheck",
      "description": "Server status and health check endpoints.",
      "item": [
        {
          "name": "Health Check (Server Ping)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has success boolean and OK message\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data.status).to.eql(\"OK\");",
                  "});",
                  "",
                  "pm.test(\"Response time is under 500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/healthcheck",
              "host": ["{{BASE_URL}}"],
              "path": ["healthcheck"]
            },
            "description": "Checks whether the backend Express server is running and accessible."
          },
          "response": [
            {
              "name": "Healthcheck Success",
              "originalRequest": {
                "method": "GET",
                "url": { "raw": "{{BASE_URL}}/healthcheck" }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"statusCode\": 200,\n  \"data\": {\n    \"status\": \"OK\"\n  },\n  \"message\": \"Health check passed\",\n  \"success\": true\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Users & Authentication",
      "description": "User registration, authentication, token refresh, profile management, and watch history.",
      "item": [
        {
          "name": "1. Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test(\"User created without password/refreshToken in response\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data).to.have.property(\"_id\");",
                  "    pm.expect(res.data).to.have.property(\"username\");",
                  "    pm.expect(res.data).to.not.have.property(\"password\");",
                  "    pm.expect(res.data).to.not.have.property(\"refreshToken\");",
                  "    ",
                  "    if (res.data._id) {",
                  "        pm.collectionVariables.set(\"USER_ID\", res.data._id);",
                  "        pm.collectionVariables.set(\"USERNAME\", res.data.username);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "fullName", "value": "Sujal Bhalala", "type": "text" },
                { "key": "email", "value": "sujal@example.com", "type": "text" },
                { "key": "username", "value": "sujal21", "type": "text" },
                { "key": "password", "value": "secretPass123", "type": "text" },
                { "key": "avatar", "type": "file", "src": "", "description": "Required avatar image (JPEG/PNG/WebP)" },
                { "key": "coverImage", "type": "file", "src": "", "description": "Optional cover banner image" }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/users/register",
              "host": ["{{BASE_URL}}"],
              "path": ["users", "register"]
            },
            "description": "Registers a new user and uploads avatar/cover image to Cloudinary."
          }
        },
        {
          "name": "2. Login User (Auto-sets Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Auto-saves Access Token & Refresh Token\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data).to.have.property(\"accessToken\");",
                  "    pm.expect(res.data).to.have.property(\"refreshToken\");",
                  "    ",
                  "    // Automatically save token for all subsequent requests!",
                  "    pm.collectionVariables.set(\"ACCESS_TOKEN\", res.data.accessToken);",
                  "    pm.collectionVariables.set(\"REFRESH_TOKEN\", res.data.refreshToken);",
                  "    pm.collectionVariables.set(\"USER_ID\", res.data.user._id);",
                  "    pm.collectionVariables.set(\"USERNAME\", res.data.user.username);",
                  "    console.log(\"🔑 ACCESS_TOKEN and REFRESH_TOKEN automatically updated in collection!\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sujal21\",\n  \"email\": \"sujal@example.com\",\n  \"password\": \"secretPass123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/users/login",
              "host": ["{{BASE_URL}}"],
              "path": ["users", "login"]
            },
            "description": "Logs in user with username/email and password. Automatically updates `ACCESS_TOKEN` variable."
          }
        },
        {
          "name": "3. Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns authenticated user details\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data._id).to.eql(pm.collectionVariables.get(\"USER_ID\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/users/current-user",
              "host": ["{{BASE_URL}}"],
              "path": ["users", "current-user"]
            },
            "description": "Retrieves the currently authenticated user profile."
          }
        },
        {
          "name": "4. Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
